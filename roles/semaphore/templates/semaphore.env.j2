SEMAPHORE_DB_DIALECT=postgres
SEMAPHORE_DB_HOST=semaphore-postgres
SEMAPHORE_DB_PORT=5432
SEMAPHORE_DB={{ semaphore_database_name }}
SEMAPHORE_DB_USER={{ semaphore_database_user }}
SEMAPHORE_DB_PASS={{ semaphore_database_password }}
SEMAPHORE_ADMIN={{ semaphore_admin_login }}
SEMAPHORE_ADMIN_PASSWORD={{ semaphore_admin_password }}
SEMAPHORE_ADMIN_NAME={{ semaphore_admin_name }}
SEMAPHORE_ADMIN_EMAIL={{ semaphore_admin_email }}
SEMAPHORE_COOKIE_HASH={{ semaphore_cookie_hash }}
SEMAPHORE_COOKIE_ENCRYPTION={{ semaphore_cookie_encryption }}
SEMAPHORE_ACCESS_KEY_ENCRYPTION={{ semaphore_access_key_encryption }}
SEMAPHORE_WEB_ROOT=https://{{ semaphore_hostname }}
SEMAPHORE_TMP_PATH=/workspace
SEMAPHORE_SSH_PATH=/etc/ssh/ssh_config.d/00-homelab.conf
SEMAPHORE_MAX_PARALLEL_TASKS=1
{% if semaphore_controller_enabled | default(false) %}
SEMAPHORE_APPS={{ {'repository_verify': {'active': true, 'title': 'Repository verification', 'path': '/opt/homelab/repository-job.py', 'args': ['--config', '/etc/semaphore/repository-job.json']}} | to_json }}
{% endif %}
{% if semaphore_controller_identity_enabled | default(false) %}
ANSIBLE_SOPS_AGE_KEY_CMD=/opt/homelab/identity-command.py
{% endif %}
