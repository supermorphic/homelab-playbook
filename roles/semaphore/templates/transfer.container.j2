[Unit]
Description=Transfer verified Semaphore backups to NAS

[Container]
ContainerName=semaphore-transfer
Image={{ semaphore_rclone_image }}
UserNS=keep-id:uid=1001,gid=1001
User=1001:1001
Environment=BACKUP_ROOT=/backups
Environment=RCLONE_REMOTE={{ semaphore_rclone_remote }}
Environment=RCLONE_CONFIG=/run/secrets/rclone.conf
Environment=LOCAL_RETENTION_DAYS={{ semaphore_local_retention_days }}
Environment=REMOTE_RETENTION_DAYS={{ semaphore_remote_retention_days }}
Volume={{ semaphore_state_root }}/credentials/rclone.conf:/run/secrets/rclone.conf:ro,Z
Volume={{ semaphore_helper_root }}/transfer.sh:/opt/homelab/transfer.sh:ro
Volume={{ semaphore_state_root }}/backups:/backups:rw,z
Entrypoint=/bin/sh
Exec=/opt/homelab/transfer.sh
NoNewPrivileges=true

[Service]
Type=oneshot
TimeoutStartSec={{ semaphore_transfer_timeout }}
RemainAfterExit=no
