[Unit]
Description=Forgejo PostgreSQL database

[Container]
ContainerName=forgejo-postgres
Image={{ forgejo_postgres_image }}
Pull=never
Network=forgejo.network
UserNS=keep-id:uid=999,gid=999
User=999:999
EnvironmentFile={{ forgejo_state_root }}/credentials/postgres.env
Volume={{ forgejo_state_root }}/credentials/postgres-admin-password:/run/secrets/postgres-admin-password:ro,z
Volume={{ forgejo_state_root }}/database:/var/lib/postgresql/data:rw,z
HealthCmd=pg_isready -U postgres -d postgres
HealthInterval=5s
HealthTimeout=3s
HealthRetries=12
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90
TimeoutStopSec=60

[Install]
WantedBy=default.target
